<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/icons8-questions-32.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Interview Questions Metadata: Admin: Content Details Viewer: v1</title>
    <link rel="apple-touch-icon" href="/icons8-questions-96.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.5.1/github-markdown-light.min.css"
    />
    <style>
      /* Custom styles for markdown content */
      .markdown-body pre {
        background-color: #f3f4f6;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
      }
      .markdown-body code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.875rem;
        color: #1f2937;
      }
      .markdown-body {
        max-width: none;
      }
    </style>
  </head>
  <body class="flex h-screen bg-gray-50 font-sans">
    <!-- Left Sidebar -->
    <aside
      id="left-section"
      class="fixed top-0 bottom-0 left-0 w-64 bg-white border-r border-gray-200 shadow-sm overflow-y-auto z-10"
    >
      <div class="p-6 sticky top-0 bg-white border-b border-gray-200">
        <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-2">
          <span>📚</span>
          <span>Markdown Files</span>
        </h2>
      </div>

      <div class="p-4">
        <% const renderFileList = (fileList) => { %>
        <ul class="space-y-2">
          <% fileList.forEach(file => { %>
          <li class="<%= file.fileType === 'directory' ? 'mt-4 first:mt-0' : '' %>">
            <% if (file.fileType === 'directory') { %>
            <div class="flex items-center gap-2 mb-2">
              <span class="text-lg font-semibold text-gray-700 flex items-center gap-2">
                <span>📁</span>
                <span><%= file.name %></span>
              </span>
            </div>
            <% if (file.children && file.children.length > 0) { %>
            <div class="ml-4 pl-3 border-l-2 border-gray-200">
              <% renderFileList(file.children); %>
            </div>
            <% } %> <% } else { %>
            <button
              onclick="navigateTo('<%= encodeURIComponent(file.path) %>')"
              class="<%= file.selected ? 'selected-file' : 'file-link' %> w-full text-left px-3 py-2 rounded-md transition-all duration-200 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-1"
            >
              <span class="flex items-center gap-2">
                <span>📄</span>
                <span class="break-words"><%= file.name %></span>
              </span>
            </button>
            <% } %>
          </li>
          <% }); %>
        </ul>
        <% } %> <% renderFileList(fileList); %>
      </div>
    </aside>

    <!-- Right Content Area -->
    <main id="right-section" class="flex-1 ml-64 overflow-y-auto">
      <div class="max-w-5xl mx-auto p-6">
        <!-- Header with Navigation -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-4 mb-6">
          <div class="flex items-center justify-between flex-wrap gap-4">
            <div>
              <h3 class="text-xl font-semibold text-gray-800 mb-1">
                Selected file:
                <span class="text-blue-600 font-normal">
                  <% if (filename) { %> <%- filename %> <% } else { %>
                  <span class="text-gray-400 italic">None</span>
                  <% } %>
                </span>
              </h3>
            </div>
            <div class="flex gap-2">
              <button
                onclick="navigateTo('<%= encodeURIComponent(filename) %>', 'prev', '<%= contentDetailsNavigationAPIUri %>')"
                class="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-medium transition-colors duration-200 flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                <%= !filename ? 'disabled' : '' %>
              >
                <span>←</span>
                <span>Previous</span>
              </button>
              <button
                onclick="navigateTo('<%= encodeURIComponent(filename) %>', 'next', '<%= contentDetailsNavigationAPIUri %>')"
                class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors duration-200 flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                <%= !filename ? 'disabled' : '' %>
              >
                <span>Next</span>
                <span>→</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Content Area -->
        <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8">
          <% if (htmlContent) { %>
          <div class="markdown-body prose prose-lg max-w-none">
            <%- htmlContent %>
          </div>
          <% } else if (filename) { %>
          <div class="text-center py-12">
            <div class="text-6xl mb-4">📭</div>
            <p class="text-xl text-gray-600 font-medium">No content available!</p>
            <p class="text-gray-500 mt-2">The file exists but has no content to display.</p>
          </div>
          <% } else { %>
          <div class="text-center py-16">
            <div class="text-6xl mb-4">👈</div>
            <p class="text-xl text-gray-600 font-medium mb-2">
              Welcome to Content Details Viewer
            </p>
            <p class="text-gray-500">
              Select a file from the left menu to render its content here.
            </p>
          </div>
          <% } %>
        </div>

        <!-- Bottom Navigation (duplicate for convenience) -->
        <% if (filename) { %>
        <div class="mt-6 flex justify-center gap-4">
          <button
            onclick="navigateTo('<%= encodeURIComponent(filename) %>', 'prev', '<%= contentDetailsNavigationAPIUri %>')"
            class="px-6 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-lg font-medium transition-colors duration-200 flex items-center gap-2 shadow-sm"
          >
            <span>←</span>
            <span>Previous File</span>
          </button>
          <button
            onclick="navigateTo('<%= encodeURIComponent(filename) %>', 'next', '<%= contentDetailsNavigationAPIUri %>')"
            class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors duration-200 flex items-center gap-2 shadow-sm"
          >
            <span>Next File</span>
            <span>→</span>
          </button>
        </div>
        <% } %>
      </div>
    </main>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        const selectedElement = document.querySelector(".selected-file");
        if (selectedElement) {
          selectedElement.scrollIntoView({
            behavior: "smooth",
            block: "center",
            inline: "start",
          });
        }
      });
    </script>
    <script>
      function navigateTo(path, direction = "", contentDetailsNavigationAPIUri = "") {
        const fileUrl = `${contentDetailsNavigationAPIUri}?${
          direction && direction.trim().length > 0 ? "direction=" + direction + "&" : ""
        }filename=${path}`;

        window.location.href = fileUrl;
      }
    </script>
    <style>
      /* Selected file styling */
      .selected-file {
        background-color: #eff6ff;
        color: #1d4ed8;
        font-weight: 600;
        border-left: 4px solid #2563eb;
      }
      .selected-file:hover {
        background-color: #dbeafe;
      }
      .file-link {
        color: #374151;
      }
      .file-link:hover {
        color: #2563eb;
        font-weight: 500;
      }
    </style>
  </body>
</html>
