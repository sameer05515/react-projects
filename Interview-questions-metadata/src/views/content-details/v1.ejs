<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/icons8-questions-32.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Interview Questions Metadata: Admin: Content Details Viewer: v1</title>
    <link rel="apple-touch-icon" href="/icons8-questions-96.png" />
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
      tailwind.config = {
        darkMode: 'class',
      }
    </script>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.5.1/github-markdown-light.min.css"
      id="markdown-light"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/github-markdown-css/5.5.1/github-markdown-dark.min.css"
      id="markdown-dark"
      media="none"
    />
    <!-- Prism.js CSS for syntax highlighting -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism.min.css"
      id="prism-light"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-dark.min.css"
      id="prism-dark"
      media="none"
    />
    <style>
      /* Custom styles for markdown content */
      .markdown-body pre {
        background-color: #f3f4f6;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        position: relative;
      }
      .dark .markdown-body pre {
        background-color: #1f2937;
      }
      .markdown-body code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 0.875rem;
        color: #1f2937;
      }
      .dark .markdown-body code {
        color: #e5e7eb;
      }
      .markdown-body {
        max-width: none;
      }
      /* Prism.js code block styling */
      .markdown-body pre[class*="language-"] {
        margin: 1rem 0;
        padding: 1.25rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        background-color: #f5f2f0;
      }
      .dark .markdown-body pre[class*="language-"] {
        background-color: #2d2d2d;
      }
      .markdown-body code[class*="language-"] {
        padding: 0;
        background: transparent;
      }
      /* Inline code styling */
      .markdown-body code:not([class*="language-"]) {
        padding: 0.2em 0.4em;
        margin: 0;
        font-size: 85%;
        background-color: rgba(175, 184, 193, 0.2);
        border-radius: 0.25rem;
      }
      .dark .markdown-body code:not([class*="language-"]) {
        background-color: rgba(110, 118, 129, 0.4);
      }
      /* Code block line numbers */
      .markdown-body pre code {
        display: block;
        padding: 0;
        background: transparent;
        color: inherit;
      }
    </style>
  </head>
  <body class="flex h-screen bg-gray-50 dark:bg-gray-900 font-sans transition-colors duration-200">
    <!-- Left Sidebar -->
    <aside
      id="left-section"
      class="fixed top-0 bottom-0 left-0 w-64 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 shadow-sm overflow-y-auto z-10 transition-colors duration-200"
    >
      <div class="p-6 sticky top-0 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 transition-colors duration-200">
        <h2 class="text-2xl font-bold text-gray-800 dark:text-gray-100 flex items-center gap-2">
          <span>📚</span>
          <span>Markdown Files</span>
        </h2>
      </div>

      <div class="p-4">
        <% 
        let directoryIndex = 0;
        const renderFileList = (fileList, parentPath = '') => { 
        %>
        <ul class="space-y-2">
          <% fileList.forEach((file, index) => { %>
          <li class="<%= file.fileType === 'directory' ? 'mt-4 first:mt-0' : '' %>">
            <% if (file.fileType === 'directory') { %>
            <% 
              directoryIndex++;
              const dirId = 'dir-' + (parentPath ? parentPath + '-' : '') + directoryIndex + '-' + index;
              const hasChildren = file.children && file.children.length > 0;
            %>
            <div class="flex items-center gap-2 mb-2">
              <button
                onclick="toggleDirectory('<%= dirId %>')"
                class="flex items-center gap-2 w-full text-left hover:bg-gray-100 dark:hover:bg-gray-700 px-2 py-1 rounded-md transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:ring-offset-1 dark:focus:ring-offset-gray-800"
                aria-expanded="true"
                aria-controls="<%= dirId %>-content"
              >
                <span id="<%= dirId %>-icon" class="text-sm transition-transform duration-200 transform rotate-90">▶</span>
                <span class="text-lg font-semibold text-gray-700 dark:text-gray-300 flex items-center gap-2">
                  <span>📁</span>
                  <span><%= file.name %></span>
                </span>
              </button>
            </div>
            <% if (hasChildren) { %>
            <div 
              id="<%= dirId %>-content" 
              class="ml-4 pl-3 border-l-2 border-gray-200 dark:border-gray-600 directory-content"
            >
              <% renderFileList(file.children, dirId); %>
            </div>
            <% } %> <% } else { %>
            <button
              onclick="navigateTo('<%= encodeURIComponent(file.path) %>')"
              class="<%= file.selected ? 'selected-file' : 'file-link' %> w-full text-left px-3 py-2 rounded-md transition-all duration-200 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500 dark:focus:ring-blue-400 focus:ring-offset-1 dark:focus:ring-offset-gray-800"
            >
              <span class="flex items-center gap-2">
                <span>📄</span>
                <span class="break-words"><%= file.name %></span>
              </span>
            </button>
            <% } %>
          </li>
          <% }); %>
        </ul>
        <% } %> <% renderFileList(fileList); %>
      </div>
    </aside>

    <!-- Right Content Area -->
    <main id="right-section" class="flex-1 ml-64 overflow-y-auto">
      <div class="max-w-5xl mx-auto p-6">
        <!-- Header with Navigation -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-4 mb-6 transition-colors duration-200">
          <div class="flex items-center justify-between flex-wrap gap-4">
            <div>
              <h3 class="text-xl font-semibold text-gray-800 dark:text-gray-100 mb-1">
                Selected file:
                <span class="text-blue-600 dark:text-blue-400 font-normal">
                  <% if (filename) { %> <%- filename %> <% } else { %>
                  <span class="text-gray-400 dark:text-gray-500 italic">None</span>
                  <% } %>
                </span>
              </h3>
            </div>
            <div class="flex gap-2 items-center">
              <button
                onclick="toggleTheme()"
                class="px-3 py-2 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 rounded-lg font-medium transition-colors duration-200 flex items-center gap-2"
                aria-label="Toggle theme"
                title="Toggle light/dark theme"
              >
                <span id="theme-icon-header" class="text-lg">🌙</span>
              </button>
              <button
                onclick="navigateTo('<%= encodeURIComponent(filename) %>', 'prev', '<%= contentDetailsNavigationAPIUri %>')"
                class="px-4 py-2 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 rounded-lg font-medium transition-colors duration-200 flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                <%= !filename ? 'disabled' : '' %>
              >
                <span>←</span>
                <span>Previous</span>
              </button>
              <button
                onclick="navigateTo('<%= encodeURIComponent(filename) %>', 'next', '<%= contentDetailsNavigationAPIUri %>')"
                class="px-4 py-2 bg-blue-600 dark:bg-blue-500 hover:bg-blue-700 dark:hover:bg-blue-600 text-white rounded-lg font-medium transition-colors duration-200 flex items-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                <%= !filename ? 'disabled' : '' %>
              >
                <span>Next</span>
                <span>→</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Content Area -->
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-sm border border-gray-200 dark:border-gray-700 p-8 transition-colors duration-200">
          <% if (htmlContent) { %>
          <div class="markdown-body prose prose-lg dark:prose-invert max-w-none">
            <%- htmlContent %>
          </div>
          <% } else if (filename) { %>
          <div class="text-center py-12">
            <div class="text-6xl mb-4">📭</div>
            <p class="text-xl text-gray-600 dark:text-gray-300 font-medium">No content available!</p>
            <p class="text-gray-500 dark:text-gray-400 mt-2">The file exists but has no content to display.</p>
          </div>
          <% } else { %>
          <div class="text-center py-16">
            <div class="text-6xl mb-4">👈</div>
            <p class="text-xl text-gray-600 dark:text-gray-300 font-medium mb-2">
              Welcome to Content Details Viewer
            </p>
            <p class="text-gray-500 dark:text-gray-400">
              Select a file from the left menu to render its content here.
            </p>
          </div>
          <% } %>
        </div>

        <!-- Bottom Navigation (duplicate for convenience) -->
        <% if (filename) { %>
        <div class="mt-6 flex justify-center gap-4">
          <button
            onclick="navigateTo('<%= encodeURIComponent(filename) %>', 'prev', '<%= contentDetailsNavigationAPIUri %>')"
            class="px-6 py-3 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 dark:hover:bg-gray-600 text-gray-700 dark:text-gray-200 rounded-lg font-medium transition-colors duration-200 flex items-center gap-2 shadow-sm"
          >
            <span>←</span>
            <span>Previous File</span>
          </button>
          <button
            onclick="navigateTo('<%= encodeURIComponent(filename) %>', 'next', '<%= contentDetailsNavigationAPIUri %>')"
            class="px-6 py-3 bg-blue-600 dark:bg-blue-500 hover:bg-blue-700 dark:hover:bg-blue-600 text-white rounded-lg font-medium transition-colors duration-200 flex items-center gap-2 shadow-sm"
          >
            <span>Next File</span>
            <span>→</span>
          </button>
        </div>
        <% } %>
      </div>
    </main>

    <script>
      // Theme management
      function getTheme() {
        return localStorage.getItem('theme') || 'light';
      }

      function setTheme(theme) {
        localStorage.setItem('theme', theme);
        const html = document.documentElement;
        const markdownLight = document.getElementById('markdown-light');
        const markdownDark = document.getElementById('markdown-dark');
        const prismLight = document.getElementById('prism-light');
        const prismDark = document.getElementById('prism-dark');
        const themeIconHeader = document.getElementById('theme-icon-header');

        if (theme === 'dark') {
          html.classList.add('dark');
          markdownLight.media = 'none';
          markdownDark.media = 'all';
          if (prismLight) prismLight.media = 'none';
          if (prismDark) prismDark.media = 'all';
          if (themeIconHeader) themeIconHeader.textContent = '☀️';
        } else {
          html.classList.remove('dark');
          markdownLight.media = 'all';
          markdownDark.media = 'none';
          if (prismLight) prismLight.media = 'all';
          if (prismDark) prismDark.media = 'none';
          if (themeIconHeader) themeIconHeader.textContent = '🌙';
        }
        
        // Re-highlight code blocks after theme change
        if (typeof Prism !== 'undefined') {
          Prism.highlightAll();
        }
      }

      function toggleTheme() {
        const currentTheme = getTheme();
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        setTheme(newTheme);
      }

      // Re-highlight code blocks when content changes
      function highlightCodeBlocks() {
        if (typeof Prism !== 'undefined') {
          // Use a small delay to ensure DOM is ready
          setTimeout(function() {
            Prism.highlightAll();
          }, 100);
        }
      }
      
      // Initialize theme and syntax highlighting on page load
      document.addEventListener("DOMContentLoaded", function () {
        // Set initial theme
        setTheme(getTheme());

        // Initialize Prism.js syntax highlighting
        highlightCodeBlocks();

        // Scroll to selected file
        const selectedElement = document.querySelector(".selected-file");
        if (selectedElement) {
          selectedElement.scrollIntoView({
            behavior: "smooth",
            block: "center",
            inline: "start",
          });
        }
      });
      
      // Use MutationObserver to highlight code when markdown content is updated
      if (typeof MutationObserver !== 'undefined') {
        document.addEventListener("DOMContentLoaded", function() {
          const markdownBody = document.querySelector('.markdown-body');
          if (markdownBody) {
            const observer = new MutationObserver(function(mutations) {
              let shouldHighlight = false;
              mutations.forEach(function(mutation) {
                if (mutation.addedNodes.length > 0 || mutation.type === 'childList') {
                  shouldHighlight = true;
                }
              });
              if (shouldHighlight) {
                highlightCodeBlocks();
              }
            });
            
            observer.observe(markdownBody, {
              childList: true,
              subtree: true
            });
          }
        });
      }
    </script>
    <script>
      function navigateTo(path, direction = "", contentDetailsNavigationAPIUri = "") {
        const fileUrl = `${contentDetailsNavigationAPIUri}?${
          direction && direction.trim().length > 0 ? "direction=" + direction + "&" : ""
        }filename=${path}`;

        window.location.href = fileUrl;
      }

      // Toggle directory collapse/expand
      function toggleDirectory(dirId) {
        const content = document.getElementById(dirId + '-content');
        const icon = document.getElementById(dirId + '-icon');
        const button = icon?.closest('button');
        
        if (!content || !icon) return;
        
        const isExpanded = content.style.display !== 'none';
        
        if (isExpanded) {
          // Collapse
          content.style.display = 'none';
          icon.classList.remove('rotate-90');
          icon.classList.add('rotate-0');
          if (button) button.setAttribute('aria-expanded', 'false');
        } else {
          // Expand
          content.style.display = 'block';
          icon.classList.remove('rotate-0');
          icon.classList.add('rotate-90');
          if (button) button.setAttribute('aria-expanded', 'true');
        }
      }
    </script>
    <style>
      /* Selected file styling */
      .selected-file {
        background-color: #eff6ff;
        color: #1d4ed8;
        font-weight: 600;
        border-left: 4px solid #2563eb;
      }
      .dark .selected-file {
        background-color: #1e3a8a;
        color: #93c5fd;
        border-left-color: #60a5fa;
      }
      .selected-file:hover {
        background-color: #dbeafe;
      }
      .dark .selected-file:hover {
        background-color: #1e40af;
      }
      .file-link {
        color: #374151;
      }
      .dark .file-link {
        color: #d1d5db;
      }
      .file-link:hover {
        color: #2563eb;
        font-weight: 500;
      }
      .dark .file-link:hover {
        color: #60a5fa;
      }
      /* Directory toggle icon styling */
      #left-section button[aria-expanded] {
        cursor: pointer;
      }
      #left-section button[aria-expanded] span:first-child {
        display: inline-block;
        width: 12px;
        text-align: center;
        color: #6b7280;
      }
      .dark #left-section button[aria-expanded] span:first-child {
        color: #9ca3af;
      }
      #left-section button[aria-expanded]:hover span:first-child {
        color: #2563eb;
      }
      .dark #left-section button[aria-expanded]:hover span:first-child {
        color: #60a5fa;
      }
      /* Smooth transition for directory content */
      .directory-content {
        transition: opacity 0.2s ease-in-out;
      }
    </style>
    <!-- Prism.js JavaScript for syntax highlighting -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/components/prism-core.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>
  </body>
</html>
